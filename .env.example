# Copy this file to .env before starting the test databases.
# These values match the database integration tests.
POSTGRES_DB=yeapf2_test
POSTGRES_USER=yeapf2
POSTGRES_PASSWORD=yeapf2
POSTGRES_PORT=35432

MYSQL_DATABASE=yeapf2_test
MYSQL_USER=yeapf2
MYSQL_PASSWORD=yeapf2
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=33306

# Optional host-side overrides read by the PHP integration helper.
# Defaults are identical to the Compose contract above.
Y2_TEST_POSTGRES_HOST=127.0.0.1
Y2_TEST_POSTGRES_PORT=35432
Y2_TEST_POSTGRES_DATABASE=yeapf2_test
Y2_TEST_POSTGRES_SCHEMA=public
Y2_TEST_POSTGRES_USER=yeapf2
Y2_TEST_POSTGRES_PASSWORD=yeapf2
Y2_TEST_MYSQL_HOST=127.0.0.1
Y2_TEST_MYSQL_PORT=33306
Y2_TEST_MYSQL_DATABASE=yeapf2_test
Y2_TEST_MYSQL_SCHEMA=yeapf2_test
Y2_TEST_MYSQL_USER=yeapf2
Y2_TEST_MYSQL_PASSWORD=yeapf2
