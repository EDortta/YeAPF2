<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="../src/yeapf-core.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         defaultTestSuite="default"
         failOnWarning="true"
         failOnDeprecation="true"
         failOnIncomplete="true"
         failOnRisky="true">
    <source>
        <include>
            <directory suffix=".php">../src</directory>
        </include>
    </source>
    <testsuites>
        <testsuite name="default">
            <file>AuthenticityCheckerTest.php</file>
            <file>BrazilDocumentPluginTest.php</file>
            <file>CodeQualityRegressionTest.php</file>
            <file>CoreBehaviorTest.php</file>
            <file>DocumentModelTest.php</file>
            <file>IntegrationDatabaseConfigTest.php</file>
            <file>LatamDocumentPluginTest.php</file>
            <file>PluginRegistryTest.php</file>
            <file>SanitizedKeyDataTest.php</file>
            <file>SecurityObservabilityBehaviorTest.php</file>
            <file>ServiceBehaviorTest.php</file>
            <file>ConcreteDDLSynthesizerTest.php</file>
            <file>DBDriverContractSkeletonTest.php</file>
            <file>DBDriverInterfaceContractTest.php</file>
            <file>DDLSynthesizerInterfaceContractTest.php</file>
            <file>DriverContractHarnessStubTest.php</file>
            <file>PDOConnectionDriverAdapterTest.php</file>
            <file>PluginRoleInterfacesContractTest.php</file>
            <file>SchemaInspectorInterfaceContractTest.php</file>
        </testsuite>
        <testsuite name="unit">
            <file>AuthenticityCheckerTest.php</file>
            <file>BrazilDocumentPluginTest.php</file>
            <file>CodeQualityRegressionTest.php</file>
            <file>CoreBehaviorTest.php</file>
            <file>DocumentModelTest.php</file>
            <file>IntegrationDatabaseConfigTest.php</file>
            <file>LatamDocumentPluginTest.php</file>
            <file>PluginRegistryTest.php</file>
            <file>SanitizedKeyDataTest.php</file>
            <file>SecurityObservabilityBehaviorTest.php</file>
            <file>ServiceBehaviorTest.php</file>
        </testsuite>
        <testsuite name="contract">
            <file>ConcreteDDLSynthesizerTest.php</file>
            <file>DBDriverContractSkeletonTest.php</file>
            <file>DBDriverInterfaceContractTest.php</file>
            <file>DDLSynthesizerInterfaceContractTest.php</file>
            <file>DriverContractHarnessStubTest.php</file>
            <file>PDOConnectionDriverAdapterTest.php</file>
            <file>PluginRoleInterfacesContractTest.php</file>
            <file>SchemaInspectorInterfaceContractTest.php</file>
        </testsuite>
        <testsuite name="integration-postgres">
            <file>ORMDockerPostgresFlowTest.php</file>
            <file>SchemaSessionBootstrapTest.php</file>
            <file>PostgreSQLDriverContractTest.php</file>
        </testsuite>
        <testsuite name="integration-mysql">
            <file>ORMDockerMySQLFlowTest.php</file>
            <file>MySQLDriverContractTest.php</file>
        </testsuite>
        <testsuite name="integration">
            <file>ORMDockerPostgresFlowTest.php</file>
            <file>SchemaSessionBootstrapTest.php</file>
            <file>PostgreSQLDriverContractTest.php</file>
            <file>ORMDockerMySQLFlowTest.php</file>
            <file>MySQLDriverContractTest.php</file>
        </testsuite>
        <testsuite name="integration-http2">
            <directory suffix="Test.php">integration-http2</directory>
        </testsuite>
    </testsuites>
</phpunit>
